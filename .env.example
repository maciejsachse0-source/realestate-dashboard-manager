# Skopiuj do .env i dostosuj. Plik .env nigdy nie trafia do repozytorium.
#
# GDZIE TEN PLIK LEZY zalezy od ukladu katalogow (narzedzia/sciezki.ps1):
#   praca na repozytorium  -> <repo>/.env
#   instalacja u uzytkownika -> C:/SystemNajmu/dane/.env
# W instalacji konfiguracja nalezy do DANYCH, nie do programu: aktualizacja
# podmienia katalog z kodem i nie ma prawa dotknac tego pliku. Sciezke podaje
# aplikacji zmienna NAJEM_PLIK_ENV, ustawiana przez uruchom.ps1.

SRODOWISKO=dev

# Baza lokalna stawiana przez skrypt narzedzia/lokalny-postgres.ps1.
# Port 5434 celowo: 5432 to typowy Postgres systemowy, 5433 bywa juz zajety.
DATABASE_URL=postgresql+psycopg://najem:najem@127.0.0.1:5434/najem

API_HOST=127.0.0.1
API_PORT=8010

# Katalog na dokumenty. Poza obszarem serwowanym przez serwer WWW.
KATALOG_DOKUMENTOW=dane/dokumenty

# Katalog z dokumentami na dysku, przeszukiwany przez ekran "Dokumenty z dysku".
# Struktura: <ten katalog>/<budynek>/Umowy najmu/<folder lokalu>/<pliki>.
# Program niczego stad nie kopiuje: dokument zostaje odnosnikiem do pliku.
# Skutek uboczny: kopia zapasowa musi obejmowac baze RAZEM z tym katalogiem.
# Wartosc ZAPASOWA: katalog ustawia sie na ekranie "Dokumenty z dysku",
# a ustawienie z bazy przykrywa to, co tutaj. Pusto = skan wylaczony,
# dopoki ktos nie wskaze katalogu w programie.
KATALOG_SKANU=C:/Users/Nazwa uzytkownika/Documents/Budynki

STREFA_PREZENTACJI=Europe/Warsaw

# Cel kopii zapasowej: dysk zewnetrzny, OneDrive albo sciezka sieciowa.
# Skryptowi narzedzia/kopia-zapasowa.ps1 jest wszystko jedno, ktore z tych to
# jest -- ma tylko byc POZA tym komputerem. Dokumenty sa linkowane, nie
# kopiowane (ADR 008), wiec awaria dysku zabiera baze i pliki naraz.
# Puste = kopia sie nie wykona i powie o tym glosno, zamiast milczec.
KATALOG_KOPII=
